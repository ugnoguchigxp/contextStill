        "resource",
        "title",
        "text",
        "snapshotHash",
        "fetchedAt",
        "truncated"
      ],
      "properties": {
        "protocolVersion": { "const": "1.0" },
        "resource": { "$ref": "#/$defs/resourceIdentity" },
        "title": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "text": { "type": "string" },
        "snapshotHash": { "$ref": "#/$defs/bareDigest" },
